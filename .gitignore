# 依赖与运行产物
node_modules/
.venv/
.wrangler/
dist/

# Python 缓存（根目录跑脚本就会生成，不该进仓库）
__pycache__/
*.pyc

# 脱敏扫描器的本地词表：真机名/私有仓库名/品牌词这些「自己的名词」放这里，
# 不进仓库（scripts/check_pii.py 会自动读它）
scripts/pii-words.local

# Python 缓存（根目录跑脚本就会生成，不该进仓库）
__pycache__/
*.pyc

# 本地数据库
*.db
*.db-wal
*.db-shm
# 机器凭据的加密密钥：跟数据库分开存，它俩都不能进仓库
*.machines.key

# 本地配置（含 token，不能进仓库）
config.toml

# 系统文件
.DS_Store
*.log

# 打包产物
build/
*.egg-info/
*.whl
